{
  "name": "claude-relocate",
  "version": "1.0.0",
  "description": "Move Claude Code's config folder to another drive or into the XDG folders, safely: settings, sessions, the plugin cache and .claude.json move together, CLAUDE_CONFIG_DIR is set to match, and undo puts everything back. Zero tokens.",
  "type": "module",
  "bin": {
    "claude-relocate": "bin/claude-relocate.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test"
  },
  "repository": "github:nrzz/claude-relocate",
  "homepage": "https://github.com/nrzz/claude-relocate#readme",
  "bugs": "https://github.com/nrzz/claude-relocate/issues",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "CLAUDE_CONFIG_DIR",
    "xdg",
    "xdg-base-directory",
    "config",
    "relocate",
    "disk-space",
    "windows",
    "dotfiles",
    "developer-tools"
  ],
  "author": "Naresh Prabu",
  "license": "MIT"
}
